<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" android:maxSdkVersion="30" />
    <!-- Nordic caps this permission at API 30; keep it available to the API 35 test scanner. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:remove="android:maxSdkVersion" />
    <application android:name="com.chimali.fido2.test.Fido2DeviceTestApplication">
        <service
            android:name="com.chimali.fido2.service.Fido2TransportService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
