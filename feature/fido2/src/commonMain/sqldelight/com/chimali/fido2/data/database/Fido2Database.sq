CREATE TABLE passkey_credential (
    id TEXT NOT NULL PRIMARY KEY,
    created_at INTEGER NOT NULL,
    last_used_at INTEGER,
    aaguid TEXT NOT NULL,
    cose_algorithm INTEGER NOT NULL DEFAULT -7,
    credential_id TEXT NOT NULL,
    cred_protect_policy INTEGER NOT NULL DEFAULT 1,
    label TEXT,
    private_key_alias TEXT NOT NULL,
    public_key TEXT NOT NULL,
    rp_id TEXT NOT NULL,
    rp_name TEXT NOT NULL,
    sign_count INTEGER NOT NULL DEFAULT 0,
    user_display_name TEXT NOT NULL,
    user_id TEXT NOT NULL,
    user_name TEXT NOT NULL,
    UNIQUE(rp_id, user_id)
);

CREATE TABLE relying_party (
    id TEXT NOT NULL PRIMARY KEY,
    created_at INTEGER NOT NULL,
    last_used_at INTEGER,
    credential_count INTEGER NOT NULL DEFAULT 0,
    icon_url TEXT,
    is_blocked INTEGER NOT NULL DEFAULT 0,
    name TEXT NOT NULL
);

CREATE TABLE user_consent_record (
    id TEXT NOT NULL PRIMARY KEY,
    timestamp INTEGER NOT NULL,
    biometric_used INTEGER NOT NULL DEFAULT 0,
    credential_id TEXT,
    device_id TEXT,
    ip_address TEXT,
    operation_type TEXT NOT NULL,
    pin_used INTEGER NOT NULL DEFAULT 0,
    rp_id TEXT NOT NULL,
    user_agent TEXT,
    FOREIGN KEY(rp_id) REFERENCES relying_party(id) ON DELETE CASCADE
);

CREATE TABLE bluetooth_hid_session (
    session_id TEXT NOT NULL PRIMARY KEY,
    start_time INTEGER NOT NULL,
    last_activity_time INTEGER NOT NULL,
    host_device_address TEXT NOT NULL,
    is_active INTEGER NOT NULL DEFAULT 1,
    protocol_version TEXT NOT NULL
);

-- Table paired_device is defined in PairedDevice.sq

-- Indexes for performance
CREATE INDEX idx_passkey_credential_rp_id ON passkey_credential(rp_id);
CREATE INDEX idx_passkey_credential_user_id ON passkey_credential(user_id);
CREATE INDEX idx_user_consent_record_rp_id ON user_consent_record(rp_id);
CREATE INDEX idx_user_consent_record_timestamp ON user_consent_record(timestamp);
CREATE INDEX idx_bluetooth_hid_session_is_active ON bluetooth_hid_session(is_active);

-- Views for common queries
CREATE VIEW credential_summary AS
SELECT 
    pc.id,
    pc.rp_id,
    rp.name AS rp_name,
    pc.user_name,
    pc.user_display_name,
    pc.created_at,
    pc.last_used_at,
    pc.sign_count
FROM passkey_credential pc
JOIN relying_party rp ON pc.rp_id = rp.id;

CREATE VIEW relying_party_stats AS
SELECT 
    rp.id,
    rp.name,
    rp.credential_count,
    COUNT(ucr.id) AS consent_count,
    MAX(ucr.timestamp) AS last_consent_time
FROM relying_party rp
LEFT JOIN user_consent_record ucr ON rp.id = ucr.rp_id
GROUP BY rp.id, rp.name, rp.credential_count;

-- Event Sourcing Infrastructure
CREATE TABLE event_store (
    aggregate_id TEXT NOT NULL,
    sequence_number INTEGER NOT NULL,
    timestamp TEXT NOT NULL,
    payload BLOB NOT NULL, -- Encrypted JSON
    PRIMARY KEY (aggregate_id, sequence_number)
);

CREATE TABLE snapshot_store (
    aggregate_id TEXT NOT NULL,
    sequence_number INTEGER NOT NULL,
    timestamp TEXT NOT NULL,
    payload BLOB NOT NULL, -- Encrypted JSON
    PRIMARY KEY (aggregate_id, sequence_number)
);

-- EventStore Queries
insert_event:
INSERT INTO event_store (aggregate_id, sequence_number, timestamp, payload)
VALUES (?, ?, ?, ?);

get_events:
SELECT * FROM event_store 
WHERE aggregate_id = ? 
AND timestamp <= ? 
ORDER BY sequence_number ASC;

get_events_from:
SELECT * FROM event_store 
WHERE aggregate_id = ? 
AND sequence_number > ? 
ORDER BY sequence_number ASC;

-- SnapshotStore Queries
insert_snapshot:
INSERT INTO snapshot_store (aggregate_id, sequence_number, timestamp, payload)
VALUES (?, ?, ?, ?);

get_latest_snapshot:
SELECT * FROM snapshot_store 
WHERE aggregate_id = ? 
ORDER BY sequence_number DESC 
LIMIT 1;

delete_old_snapshots:
DELETE FROM snapshot_store 
WHERE aggregate_id = ? 
AND sequence_number NOT IN (
    SELECT sequence_number FROM snapshot_store 
    WHERE aggregate_id = ? 
    ORDER BY sequence_number DESC 
    LIMIT 2
);

truncate_all:
DELETE FROM passkey_credential;
DELETE FROM relying_party;
DELETE FROM user_consent_record;
DELETE FROM bluetooth_hid_session;
DELETE FROM event_store;
DELETE FROM snapshot_store;
