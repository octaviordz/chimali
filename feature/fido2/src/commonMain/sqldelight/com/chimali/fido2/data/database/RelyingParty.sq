insert:
INSERT INTO relying_party (id, created_at, last_used_at, credential_count, icon_url, is_blocked, name)
VALUES (?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
  last_used_at = excluded.last_used_at,
  credential_count = excluded.credential_count,
  icon_url = excluded.icon_url,
  is_blocked = excluded.is_blocked,
  name = excluded.name;

update:
UPDATE relying_party
SET last_used_at = ?, credential_count = ?, icon_url = ?, is_blocked = ?, name = ?
WHERE id = ?;

select_by_id:
SELECT * FROM relying_party WHERE id = ?;

select_all:
SELECT * FROM relying_party;

search_by_name:
SELECT * FROM relying_party WHERE name LIKE :query;

delete_by_id:
DELETE FROM relying_party WHERE id = ?;

delete_stats:
DELETE FROM relying_party_stats WHERE id = ?;

get_stats:
SELECT * FROM relying_party_stats WHERE id = ?;

get_all_stats:
SELECT * FROM relying_party_stats;

update_credential_count:
UPDATE relying_party SET credential_count = :credential_count, last_used_at = :last_used_at WHERE id = :id;

is_blocked:
SELECT is_blocked FROM relying_party WHERE id = :id; 

select_with_credentials:
SELECT * FROM relying_party WHERE credential_count > 0;

select_without_credentials:
SELECT * FROM relying_party WHERE credential_count = 0;

select_blocked:
SELECT * FROM relying_party WHERE 1=0;

select_unblocked:
SELECT * FROM relying_party;

select_by_credential_count:
SELECT * FROM relying_party ORDER BY credential_count DESC LIMIT :limit;

select_by_last_used:
SELECT * FROM relying_party LIMIT :limit;

select_by_creation_date:
SELECT * FROM relying_party ORDER BY created_at DESC LIMIT :limit;

select_by_date_range:
SELECT * FROM relying_party WHERE created_at >= :start AND created_at <= :end;

select_unused:
SELECT * FROM relying_party WHERE created_at < :cutoff_date;

count_all:
SELECT count(*) FROM relying_party;

count_with_credentials:
SELECT count(*) FROM relying_party WHERE credential_count > 0;

count_blocked:
SELECT 0;

exists_by_id:
SELECT count(*) > 0 FROM relying_party WHERE id = :id;

select_by_domain:
SELECT * FROM relying_party WHERE id LIKE :domain;

select_by_credential_count_range:
SELECT * FROM relying_party WHERE credential_count >= :min AND credential_count <= :max;

delete_empty_relying_parties:
DELETE FROM relying_party WHERE credential_count = 0;

changes:
SELECT changes();

get_top_relying_parties:
SELECT * FROM relying_party ORDER BY credential_count DESC LIMIT :limit;

increment_credential_count:
UPDATE relying_party SET credential_count = credential_count + 1, last_used_at = :last_used_at WHERE id = :id;

decrement_credential_count:
UPDATE relying_party SET credential_count = credential_count - 1, last_used_at = :last_used_at WHERE id = :id;

update_last_used_at:
UPDATE relying_party SET last_used_at = :last_used_at WHERE id = :id;

update_blocked_status:
UPDATE relying_party SET is_blocked = :is_blocked WHERE id = :id;
