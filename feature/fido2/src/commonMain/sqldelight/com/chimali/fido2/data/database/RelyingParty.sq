insert:
INSERT INTO relying_party (id, created_at, last_used_at, updated_at, credential_count, encrypted_metadata, icon_url, is_blocked, name)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
  last_used_at = CASE
    WHEN relying_party.last_used_at IS NULL THEN excluded.last_used_at
    WHEN excluded.last_used_at IS NULL THEN relying_party.last_used_at
    ELSE MAX(relying_party.last_used_at, excluded.last_used_at)
  END,
  updated_at = MAX(
    relying_party.updated_at + 1,
    excluded.updated_at,
    relying_party.created_at,
    COALESCE(excluded.last_used_at, relying_party.last_used_at, relying_party.created_at)
  ),
  credential_count = excluded.credential_count,
  icon_url = excluded.icon_url,
  is_blocked = excluded.is_blocked,
  name = excluded.name,
  encrypted_metadata = excluded.encrypted_metadata;

update:
UPDATE relying_party
SET last_used_at = CASE
        WHEN :last_used_at IS NULL THEN last_used_at
        WHEN last_used_at IS NULL THEN :last_used_at
        ELSE MAX(last_used_at, :last_used_at)
    END,
    credential_count = :credential_count, icon_url = :icon_url, is_blocked = :is_blocked,
    name = :name, encrypted_metadata = :encrypted_metadata,
    updated_at = MAX(
        updated_at + 1,
        CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER),
        COALESCE(:last_used_at, last_used_at, created_at)
    )
WHERE id = :id;

select_by_id:
SELECT * FROM relying_party WHERE id = ?;

select_created_at:
SELECT created_at FROM relying_party WHERE id = ?;

select_all:
SELECT * FROM relying_party;

search_by_name:
SELECT * FROM relying_party WHERE CAST(name AS TEXT) LIKE :query;

delete_by_id:
DELETE FROM relying_party WHERE id = ?;

delete_stats:
DELETE FROM relying_party_stats WHERE id = ?;

get_stats:
SELECT * FROM relying_party_stats WHERE id = ?;

get_all_stats:
SELECT * FROM relying_party_stats;

update_credential_count:
UPDATE relying_party SET credential_count = :credential_count, last_used_at = :last_used_at, updated_at = MAX(updated_at + 1, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), :last_used_at) WHERE id = :id;

is_blocked:
SELECT is_blocked FROM relying_party WHERE id = :id; 

select_with_credentials:
SELECT * FROM relying_party WHERE credential_count > 0;

select_without_credentials:
SELECT * FROM relying_party WHERE credential_count = 0;

select_blocked:
SELECT * FROM relying_party WHERE 1=0;

select_unblocked:
SELECT * FROM relying_party;

select_by_credential_count:
SELECT * FROM relying_party ORDER BY credential_count DESC LIMIT :limit;

select_by_last_used:
SELECT * FROM relying_party LIMIT :limit;

select_by_creation_date:
SELECT * FROM relying_party ORDER BY created_at DESC LIMIT :limit;

select_by_date_range:
SELECT * FROM relying_party WHERE created_at >= :start AND created_at <= :end;

select_unused:
SELECT * FROM relying_party WHERE created_at < :cutoff_date;

count_all:
SELECT count(*) FROM relying_party;

count_with_credentials:
SELECT count(*) FROM relying_party WHERE credential_count > 0;

count_blocked:
SELECT 0;

exists_by_id:
SELECT count(*) > 0 FROM relying_party WHERE id = :id;

select_by_domain:
SELECT * FROM relying_party WHERE CAST(id AS TEXT) LIKE :domain;

select_by_credential_count_range:
SELECT * FROM relying_party WHERE credential_count >= :min AND credential_count <= :max;

delete_empty_relying_parties:
DELETE FROM relying_party WHERE credential_count = 0;

changes:
SELECT changes();

get_top_relying_parties:
SELECT * FROM relying_party ORDER BY credential_count DESC LIMIT :limit;

increment_credential_count:
UPDATE relying_party SET credential_count = credential_count + 1, last_used_at = :last_used_at, updated_at = MAX(updated_at + 1, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), :last_used_at) WHERE id = :id;

decrement_credential_count:
UPDATE relying_party SET credential_count = credential_count - 1, last_used_at = :last_used_at, updated_at = MAX(updated_at + 1, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), :last_used_at) WHERE id = :id;

update_last_used_at:
UPDATE relying_party SET last_used_at = :last_used_at, updated_at = MAX(updated_at + 1, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), :last_used_at) WHERE id = :id;

update_blocked_status:
UPDATE relying_party SET is_blocked = :is_blocked, updated_at = MAX(updated_at + 1, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER)) WHERE id = :id;
