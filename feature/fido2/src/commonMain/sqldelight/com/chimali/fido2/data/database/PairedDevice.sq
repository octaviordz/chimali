CREATE TABLE paired_device (
    mac_address TEXT NOT NULL PRIMARY KEY,
    created_at INTEGER NOT NULL,
    last_used_at INTEGER NOT NULL,
    alias TEXT,
    device_class INTEGER,
    name TEXT
);

insert_or_replace:
INSERT OR REPLACE INTO paired_device (mac_address, created_at, last_used_at, alias, device_class, name)
VALUES (?, ?, ?, ?, ?, ?);

update_alias:
UPDATE paired_device SET alias = ? WHERE mac_address = ?;

select_all:
SELECT * FROM paired_device ORDER BY last_used_at DESC;

delete_by_address:
DELETE FROM paired_device WHERE mac_address = ?;

select_by_address:
SELECT * FROM paired_device WHERE mac_address = ?;
