insert:
INSERT INTO passkey_credential (id, created_at, last_used_at, aaguid, cose_algorithm, credential_id, cred_protect_policy, label, private_key_alias, public_key, rp_id, rp_name, sign_count, user_display_name, user_id, user_name)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE passkey_credential 
SET last_used_at = ?, label = ?, rp_name = ?, sign_count = ?, user_display_name = ?, user_name = ?
WHERE id = ?;

update_label:
UPDATE passkey_credential SET label = ? WHERE id = ?;

update_public_key:
UPDATE passkey_credential SET public_key = ? WHERE id = ?;

select_by_id:
SELECT * FROM passkey_credential WHERE id = ?;

select_by_rp_id:
SELECT * FROM passkey_credential WHERE rp_id = ?;

select_by_user_id:
SELECT * FROM passkey_credential WHERE user_id = ?;

select_all:
SELECT * FROM passkey_credential;

delete_by_id:
DELETE FROM passkey_credential WHERE id = ?;

delete_by_rp_id:
DELETE FROM passkey_credential WHERE rp_id = ?;

delete_by_user_id:
DELETE FROM passkey_credential WHERE user_id = ?;

search_by_rp_id:
SELECT * FROM passkey_credential
WHERE rp_id = :rp_id AND (user_name LIKE :query OR user_display_name LIKE :query);

search_all:
SELECT * FROM passkey_credential
WHERE user_name LIKE :query OR user_display_name LIKE :query;

select_expired:
SELECT * FROM passkey_credential WHERE last_used_at < ?;

update_last_used_at:
UPDATE passkey_credential SET last_used_at = ? WHERE id = ?;

update_sign_count:
UPDATE passkey_credential SET sign_count = ? WHERE id = ?;

get_sign_count:
SELECT sign_count FROM passkey_credential WHERE id = ?;

select_unused:
SELECT * FROM passkey_credential WHERE last_used_at < :cutoff_date;

select_by_last_used:
SELECT * FROM passkey_credential ORDER BY last_used_at DESC LIMIT :limit;

select_by_creation_date:
SELECT * FROM passkey_credential ORDER BY created_at DESC LIMIT :limit;

count_by_rp_id:
SELECT count(*) FROM passkey_credential WHERE rp_id = :rp_id;

count_by_user_id:
SELECT count(*) FROM passkey_credential WHERE user_id = :user_id;

count_all:
SELECT count(*) FROM passkey_credential;

exists_by_id:
SELECT count(*) > 0 FROM passkey_credential WHERE id = :id;

select_by_aaguid:
SELECT * FROM passkey_credential WHERE aaguid = :aaguid;

select_by_sign_count_above:
SELECT * FROM passkey_credential WHERE sign_count >= :threshold;

changes:
SELECT changes();

get_statistics_by_rp_id:
SELECT rp_id, count(*) FROM passkey_credential GROUP BY rp_id;

get_statistics_by_user_id:
SELECT user_id, count(*) FROM passkey_credential GROUP BY user_id;

select_by_rp_id_and_user_id:
SELECT * FROM passkey_credential WHERE rp_id = ? AND user_id = ?;

get_paged_credentials:
SELECT * FROM passkey_credential
ORDER BY last_used_at DESC
LIMIT :limit OFFSET :offset;

get_paged_credentials_by_rp_id:
SELECT * FROM passkey_credential
WHERE rp_id = :rp_id
ORDER BY last_used_at DESC
LIMIT :limit OFFSET :offset;
