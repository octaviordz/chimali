insert:
INSERT INTO PasskeyCredential (id, rpId, rpName, userId, userName, userDisplayName, publicKey, privateKeyAlias, signCount, createdAt, lastUsedAt, aaguid, credentialId)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE PasskeyCredential 
SET rpName = ?, userName = ?, userDisplayName = ?, signCount = ?, lastUsedAt = ?
WHERE id = ?;

selectById:
SELECT * FROM PasskeyCredential WHERE id = ?;

selectByRpId:
SELECT * FROM PasskeyCredential WHERE rpId = ?;

selectByUserId:
SELECT * FROM PasskeyCredential WHERE userId = ?;

selectAll:
SELECT * FROM PasskeyCredential;

deleteById:
DELETE FROM PasskeyCredential WHERE id = ?;

deleteByRpId:
DELETE FROM PasskeyCredential WHERE rpId = ?;

deleteByUserId:
DELETE FROM PasskeyCredential WHERE userId = ?;

searchByRpId:
SELECT * FROM PasskeyCredential
WHERE rpId = :rpId AND (userName LIKE :query OR userDisplayName LIKE :query);

searchAll:
SELECT * FROM PasskeyCredential
WHERE userName LIKE :query OR userDisplayName LIKE :query;

selectExpired:
SELECT * FROM PasskeyCredential WHERE lastUsedAt < ?;

updateLastUsedAt:
UPDATE PasskeyCredential SET lastUsedAt = ? WHERE credentialId = ?;

updateSignCount:
UPDATE PasskeyCredential SET signCount = ? WHERE credentialId = ?;

getSignCount:
SELECT signCount FROM PasskeyCredential WHERE credentialId = ?;

selectUnused:
SELECT * FROM PasskeyCredential WHERE lastUsedAt < :cutoffDate;
selectByLastUsed:
SELECT * FROM PasskeyCredential ORDER BY lastUsedAt DESC LIMIT :limit;
selectByCreationDate:
SELECT * FROM PasskeyCredential ORDER BY createdAt DESC LIMIT :limit;
countByRpId:
SELECT count(*) FROM PasskeyCredential WHERE rpId = :rpId;
countByUserId:
SELECT count(*) FROM PasskeyCredential WHERE userId = :userId;
countAll:
SELECT count(*) FROM PasskeyCredential;
existsById:
SELECT count(*) > 0 FROM PasskeyCredential WHERE id = :id;
selectByAaguid:
SELECT * FROM PasskeyCredential WHERE aaguid = :aaguid;
selectBySignCountAbove:
SELECT * FROM PasskeyCredential WHERE signCount >= :threshold;
changes:
SELECT changes();
getStatisticsByRpId:
SELECT rpId, count(*) FROM PasskeyCredential GROUP BY rpId;
getStatisticsByUserId:
SELECT userId, count(*) FROM PasskeyCredential GROUP BY userId;
