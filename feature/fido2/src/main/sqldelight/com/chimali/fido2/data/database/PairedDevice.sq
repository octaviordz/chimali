CREATE TABLE PairedDevice (
    macAddress TEXT NOT NULL PRIMARY KEY,
    createdAt INTEGER NOT NULL,
    lastUsedAt INTEGER NOT NULL,
    alias TEXT,
    deviceClass INTEGER,
    name TEXT
);

insertOrReplace:
INSERT OR REPLACE INTO PairedDevice (macAddress, createdAt, lastUsedAt, alias, deviceClass, name)
VALUES (?, ?, ?, ?, ?, ?);

updateAlias:
UPDATE PairedDevice SET alias = ? WHERE macAddress = ?;

selectAll:
SELECT * FROM PairedDevice ORDER BY lastUsedAt DESC;

deleteByAddress:
DELETE FROM PairedDevice WHERE macAddress = ?;

selectByAddress:
SELECT * FROM PairedDevice WHERE macAddress = ?;
