[hook "local-ci-lint"]
	event = pre-commit
	command = pwsh -NoProfile -ExecutionPolicy Bypass -File ./tools/local-ci.ps1 -SkipTests

[hook "integration-ci"]
	event = pre-push
	command = pwsh -NoProfile -ExecutionPolicy Bypass -Command "if (git rev-parse --verify origin/HEAD 2>$null) { & pwsh -NoProfile -ExecutionPolicy Bypass -File ./tools/integration-ci.ps1 -TargetRef origin/HEAD } else { & pwsh -NoProfile -ExecutionPolicy Bypass -File ./tools/local-ci.ps1 }"
