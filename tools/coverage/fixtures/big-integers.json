      "expected_error": "nonnegative integer"
    },
    {
      "id": "BIGINT_004_FRACTIONAL",
      "description": "Rejects fractional coverage count",
      "label": "fixture count",
      "value": "1.5",
      "expected_error": "nonnegative integer"
    },
    {
      "id": "BIGINT_005_NONCANONICAL",
