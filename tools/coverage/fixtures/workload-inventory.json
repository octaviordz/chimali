{
  "cases": [
    {
      "id": "WORKLOAD_INVENTORY_001_EXACT_POLICY_SET_ACCEPTED",
      "description": "Accepts the exact configured host tasks and required/optional device modules",
      "expected_valid": true
    },
    {
      "id": "WORKLOAD_INVENTORY_002_OMITTED_HOST_REJECTED",
      "description": "Rejects a missing configured host task",
      "mutation": "omit-host",
      "expected_error": "Host workload task inventory differs",
      "expected_valid": false
    },
    {
      "id": "WORKLOAD_INVENTORY_003_DUPLICATE_HOST_REJECTED",
      "description": "Rejects duplicate host task evidence",
      "mutation": "duplicate-host",
      "expected_error": "duplicate task records",
      "expected_valid": false
    },
    {
      "id": "WORKLOAD_INVENTORY_004_HOST_REASSIGNMENT_REJECTED",
      "description": "Rejects a host task attributed to another configured module",
      "mutation": "reassign-host",
      "expected_error": "Host workload task inventory differs",
      "expected_valid": false
    },
    {
      "id": "WORKLOAD_INVENTORY_005_OMITTED_REQUIRED_DEVICE_REJECTED",
      "description": "Rejects omission of a configured required device module",
      "mutation": "omit-device",
      "expected_error": "required_device_tasks does not exactly match",
      "expected_valid": false
    },
    {
      "id": "WORKLOAD_INVENTORY_006_BROAD_DEVICE_TASK_REJECTED",
      "description": "Rejects a broad device task that is not owned by the configured module",
      "mutation": "broad-device",
      "expected_error": "unowned or unconfigured task",
      "expected_valid": false
    },
    {
      "id": "WORKLOAD_INVENTORY_007_BROAD_HOST_ROOT_REJECTED",
      "description": "Rejects a host JUnit root broader than its configured task output",
      "mutation": "broad-root",
      "expected_error": "Host task JUnit root does not match",
      "expected_valid": false
    },
    {
      "id": "WORKLOAD_INVENTORY_008_ZERO_REQUIRED_DEVICE_TESTS_REJECTED",
      "description": "Rejects an otherwise complete required device task with no actual testcases",
      "mutation": "zero-required-device-suite",
      "expected_error": "no actual testcase outcomes",
      "expected_valid": false
    },
    {
      "id": "WORKLOAD_INVENTORY_009_ZERO_OPTIONAL_DEVICE_TESTS_ALLOWED",
      "description": "Allows an explicitly optional device task to have no testcase outcomes",
      "mutation": "zero-optional-device-suite",
      "expected_valid": true
    },
    {
      "id": "WORKLOAD_INVENTORY_010_EXCLUSION_RECEIPT_REQUIRED",
      "description": "Requires the FIDO2 workload receipt to retain the policy-applied empirical test exclusions",
      "mutation": "omit-routine-exclusion-evidence",
      "expected_error": "exclusion evidence differs from reviewed routine workload policy",
      "expected_valid": false
    },
    {
      "id": "WORKLOAD_INVENTORY_011_APPLIED_EXCLUSION_ABSENT_FROM_JUNIT",
      "description": "Rejects a routine device JUnit report that still contains an excluded research suite",
      "mutation": "include-routine-excluded-suite",
      "expected_error": "contains policy-excluded routine device suites",
      "expected_valid": false
    },
    {
      "id": "WORKLOAD_INVENTORY_012_HISTORICAL_SOURCE_OPTIONAL_EXCLUSION",
      "description": "Allows an optional class exclusion to be absent from a historical source revision when its JUnit suite is also absent",
      "mutation": "omit-source-optional-exclusion",
      "expected_valid": true
    },
    {
      "id": "WORKLOAD_INVENTORY_013_SOURCE_OPTIONAL_EXCLUSION_MUST_NOT_RUN",
      "description": "Rejects an optional class exclusion that is absent from the capture receipt when its JUnit suite is present",
      "mutation": "include-source-optional-excluded-suite",
      "expected_error": "contains policy-excluded routine device suites",
      "expected_valid": false
    }
  ]
}
