import kotlin.String;

CREATE TABLE identity (
    id TEXT NOT NULL PRIMARY KEY,
    alias TEXT NOT NULL
);

CREATE TABLE label (
    id TEXT NOT NULL PRIMARY KEY,
    color_hex TEXT NOT NULL,
    name TEXT NOT NULL
);

CREATE TABLE identity_backup (
    id TEXT NOT NULL PRIMARY KEY,
    last_backed_up_at TEXT NOT NULL,
    backup_method TEXT NOT NULL,
    configuration_json TEXT NOT NULL,
    identity_id TEXT NOT NULL,
    FOREIGN KEY(identity_id) REFERENCES identity(id) ON DELETE CASCADE
);

CREATE TABLE vault_entry (
    id TEXT NOT NULL PRIMARY KEY,
    date_created TEXT NOT NULL,
    date_modified TEXT NOT NULL,
    last_backed_up_at TEXT,
    crdt_state BLOB NOT NULL,
    doc_id TEXT NOT NULL,
    encrypted_payload BLOB NOT NULL,
    identity_id TEXT NOT NULL,
    title TEXT NOT NULL,
    type TEXT NOT NULL,
    FOREIGN KEY(identity_id) REFERENCES identity(id) ON DELETE CASCADE
);

CREATE TABLE vault_entry_label (
    entry_id TEXT NOT NULL,
    label_id TEXT NOT NULL,
    PRIMARY KEY (entry_id, label_id),
    FOREIGN KEY(entry_id) REFERENCES vault_entry(id) ON DELETE CASCADE,
    FOREIGN KEY(label_id) REFERENCES label(id) ON DELETE CASCADE
);

CREATE TABLE event_store (
    aggregate_id TEXT NOT NULL,
    sequence_number INTEGER NOT NULL,
    timestamp TEXT NOT NULL,
    payload BLOB NOT NULL,
    PRIMARY KEY (aggregate_id, sequence_number)
);

CREATE TABLE snapshot_store (
    aggregate_id TEXT NOT NULL,
    sequence_number INTEGER NOT NULL,
    timestamp TEXT NOT NULL,
    payload BLOB NOT NULL,
    PRIMARY KEY (aggregate_id, sequence_number)
);

-- Identity Queries
insert_identity:
INSERT OR REPLACE INTO identity(id, alias)
VALUES (?, ?);

get_identities:
SELECT id, alias FROM identity;

get_identity_by_id:
SELECT id, alias FROM identity WHERE id = ?;

delete_identity:
DELETE FROM identity WHERE id = ?;

-- IdentityBackup Queries
insert_identity_backup:
INSERT OR REPLACE INTO identity_backup(id, last_backed_up_at, backup_method, configuration_json, identity_id)
VALUES (?, ?, ?, ?, ?);

get_identity_backups:
SELECT id, last_backed_up_at, backup_method, configuration_json, identity_id FROM identity_backup WHERE identity_id = ?;

delete_identity_backup:
DELETE FROM identity_backup WHERE id = ?;

-- VaultEntry Queries
insert_vault_entry:
INSERT OR REPLACE INTO vault_entry(id, date_created, date_modified, last_backed_up_at, crdt_state, doc_id, encrypted_payload, identity_id, title, type)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

get_vault_entries:
SELECT id, date_created, date_modified, last_backed_up_at, crdt_state, doc_id, encrypted_payload, identity_id, title, type FROM vault_entry;

get_vault_entries_by_identity:
SELECT id, date_created, date_modified, last_backed_up_at, crdt_state, doc_id, encrypted_payload, identity_id, title, type FROM vault_entry WHERE identity_id = ?;

get_vault_entry_by_id:
SELECT id, date_created, date_modified, last_backed_up_at, crdt_state, doc_id, encrypted_payload, identity_id, title, type FROM vault_entry WHERE id = ?;

delete_vault_entry:
DELETE FROM vault_entry WHERE id = ?;

-- Label Queries
insert_label:
INSERT OR REPLACE INTO label(id, color_hex, name)
VALUES (?, ?, ?);

get_labels:
SELECT id, color_hex, name FROM label;

delete_label:
DELETE FROM label WHERE id = ?;

-- VaultEntryLabel Queries
insert_vault_entry_label:
INSERT OR REPLACE INTO vault_entry_label(entry_id, label_id)
VALUES (?, ?);

delete_vault_entry_labels:
DELETE FROM vault_entry_label WHERE entry_id = ?;

get_vault_entries_by_label:
SELECT id, date_created, date_modified, last_backed_up_at, crdt_state, doc_id, encrypted_payload, identity_id, title, type FROM vault_entry
INNER JOIN vault_entry_label ON vault_entry.id = vault_entry_label.entry_id
WHERE vault_entry_label.label_id = ?;

-- EventStore Queries
insert_event:
INSERT INTO event_store (aggregate_id, sequence_number, timestamp, payload)
VALUES (?, ?, ?, ?);

get_events:
SELECT * FROM event_store 
WHERE aggregate_id = ? 
AND timestamp <= ? 
ORDER BY sequence_number ASC;

get_events_from:
SELECT * FROM event_store 
WHERE aggregate_id = ? 
AND sequence_number > ? 
ORDER BY sequence_number ASC;

-- SnapshotStore Queries
insert_snapshot:
INSERT INTO snapshot_store (aggregate_id, sequence_number, timestamp, payload)
VALUES (?, ?, ?, ?);

get_latest_snapshot:
SELECT * FROM snapshot_store 
WHERE aggregate_id = ? 
ORDER BY sequence_number DESC 
LIMIT 1;

delete_old_snapshots:
DELETE FROM snapshot_store 
WHERE aggregate_id = ? 
AND sequence_number NOT IN (
    SELECT sequence_number FROM snapshot_store 
    WHERE aggregate_id = ? 
    ORDER BY sequence_number DESC 
    LIMIT 2
);

truncate_all:
DELETE FROM vault_entry;
DELETE FROM identity_backup;
DELETE FROM identity;
DELETE FROM vault_entry_label;
DELETE FROM label;
DELETE FROM event_store;
DELETE FROM snapshot_store;
