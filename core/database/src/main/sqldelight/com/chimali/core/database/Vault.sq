import kotlin.String;

CREATE TABLE Identity (
    id TEXT NOT NULL PRIMARY KEY,
    alias TEXT NOT NULL
);

CREATE TABLE IdentityBackup (
    id TEXT NOT NULL PRIMARY KEY,
    identity_id TEXT NOT NULL,
    last_backed_up_at TEXT NOT NULL,
    backup_method TEXT NOT NULL,
    configuration_json TEXT NOT NULL,
    FOREIGN KEY(identity_id) REFERENCES Identity(id) ON DELETE CASCADE
);

CREATE TABLE VaultEntry (
    id TEXT NOT NULL PRIMARY KEY,
    doc_id TEXT NOT NULL,
    type TEXT NOT NULL,
    title TEXT NOT NULL,
    encrypted_payload BLOB NOT NULL,
    crdt_state BLOB NOT NULL,
    date_created TEXT NOT NULL,
    date_modified TEXT NOT NULL,
    last_backed_up_at TEXT,
    identity_id TEXT NOT NULL,
    FOREIGN KEY(identity_id) REFERENCES Identity(id) ON DELETE CASCADE
);

CREATE TABLE Label (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    color_hex TEXT NOT NULL
);

CREATE TABLE VaultEntryLabel (
    entry_id TEXT NOT NULL,
    label_id TEXT NOT NULL,
    PRIMARY KEY (entry_id, label_id),
    FOREIGN KEY(entry_id) REFERENCES VaultEntry(id) ON DELETE CASCADE,
    FOREIGN KEY(label_id) REFERENCES Label(id) ON DELETE CASCADE
);

-- Identity Queries
insertIdentity:
INSERT OR REPLACE INTO Identity(id, alias)
VALUES (?, ?);

getIdentities:
SELECT id, alias FROM Identity;

getIdentityById:
SELECT id, alias FROM Identity WHERE id = ?;

deleteIdentity:
DELETE FROM Identity WHERE id = ?;

-- IdentityBackup Queries
insertIdentityBackup:
INSERT OR REPLACE INTO IdentityBackup(id, identity_id, last_backed_up_at, backup_method, configuration_json)
VALUES (?, ?, ?, ?, ?);

getIdentityBackups:
SELECT id, identity_id, last_backed_up_at, backup_method, configuration_json FROM IdentityBackup WHERE identity_id = ?;

deleteIdentityBackup:
DELETE FROM IdentityBackup WHERE id = ?;

-- VaultEntry Queries
insertVaultEntry:
INSERT OR REPLACE INTO VaultEntry(id, doc_id, type, title, encrypted_payload, crdt_state, date_created, date_modified, last_backed_up_at, identity_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getVaultEntries:
SELECT id, doc_id, type, title, encrypted_payload, crdt_state, date_created, date_modified, last_backed_up_at, identity_id FROM VaultEntry;

getVaultEntriesByIdentity:
SELECT id, doc_id, type, title, encrypted_payload, crdt_state, date_created, date_modified, last_backed_up_at, identity_id FROM VaultEntry WHERE identity_id = ?;

getVaultEntryById:
SELECT id, doc_id, type, title, encrypted_payload, crdt_state, date_created, date_modified, last_backed_up_at, identity_id FROM VaultEntry WHERE id = ?;

deleteVaultEntry:
DELETE FROM VaultEntry WHERE id = ?;

-- Label Queries
insertLabel:
INSERT OR REPLACE INTO Label(id, name, color_hex)
VALUES (?, ?, ?);

getLabels:
SELECT id, name, color_hex FROM Label;

deleteLabel:
DELETE FROM Label WHERE id = ?;

-- VaultEntryLabel Queries
insertVaultEntryLabel:
INSERT OR REPLACE INTO VaultEntryLabel(entry_id, label_id)
VALUES (?, ?);

deleteVaultEntryLabels:
DELETE FROM VaultEntryLabel WHERE entry_id = ?;

getVaultEntriesByLabel:
SELECT id, doc_id, type, title, encrypted_payload, crdt_state, date_created, date_modified, last_backed_up_at, identity_id FROM VaultEntry
INNER JOIN VaultEntryLabel ON VaultEntry.id = VaultEntryLabel.entry_id
WHERE VaultEntryLabel.label_id = ?;

-- FIDO2 Credential
CREATE TABLE Fido2Credential (
    credential_id BLOB NOT NULL PRIMARY KEY,
    identity_id TEXT NOT NULL,
    public_key BLOB NOT NULL,
    user_handle BLOB NOT NULL,
    sign_count INTEGER NOT NULL DEFAULT 0,
    created_at TEXT NOT NULL,
    metadata_json TEXT NOT NULL,
    FOREIGN KEY(identity_id) REFERENCES Identity(id) ON DELETE CASCADE
);

insertFido2Credential:
INSERT OR REPLACE INTO Fido2Credential(credential_id, identity_id, public_key, user_handle, sign_count, created_at, metadata_json)
VALUES (?, ?, ?, ?, ?, ?, ?);

getFido2CredentialsByIdentity:
SELECT * FROM Fido2Credential WHERE identity_id = ?;

getFido2CredentialById:
SELECT * FROM Fido2Credential WHERE credential_id = ?;

updateFido2SignCount:
UPDATE Fido2Credential SET sign_count = ? WHERE credential_id = ?;

deleteFido2Credential:
DELETE FROM Fido2Credential WHERE credential_id = ?;

-- Paired Bluetooth Devices (US3)
CREATE TABLE PairedDevice (
    address TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    first_paired_at TEXT NOT NULL,
    last_connected_at TEXT
);

insertPairedDevice:
INSERT OR REPLACE INTO PairedDevice(address, name, first_paired_at, last_connected_at)
VALUES (?, ?, ?, ?);

getAllPairedDevices:
SELECT * FROM PairedDevice ORDER BY last_connected_at DESC;

updateLastConnected:
UPDATE PairedDevice SET last_connected_at = ? WHERE address = ?;

deletePairedDevice:
DELETE FROM PairedDevice WHERE address = ?;
